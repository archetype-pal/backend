# Local/CI test environment. Credentials are random and must be regenerated
# per environment — never reuse in production.
COMPOSE_FILE=compose.yaml
# COMPOSE_FILE=compose.yaml:old-database.sql

SECRET_KEY="test-only-F_2WlLpYoTNaTc1ae_ucqmrH_M5yGPoC"
DEBUG=true
SEARCH_AUTO_REINDEX=false
SEARCH_REINDEX_DEBOUNCE_SECONDS=10
SITE_NAME="Local test"

# Compose/runtime services
MEILI_ENV=development
DJANGO_SETTINGS_MODULE=config.settings
MEILISEARCH_URL=http://meilisearch:7700
# Blank on purpose; declared so compose stops warning.
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# PostgreSQL service
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=F_2WlLpYoTNaTc1ae_ucqmrH_M5yGPoC
PGDATA=/var/lib/postgresql/18/docker

# pgAdmin service
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Database
DATABASE_URL="postgresql://postgres:F_2WlLpYoTNaTc1ae_ucqmrH_M5yGPoC@postgres:5432/local"

# IIIF
IIIF_HOST=http://localhost:8182
# Server-to-server address for the same SIPI instance: `api` reaches it via
# the compose service name, since `localhost` from inside that container is
# the `api` container itself, not `image_server`.
IIIF_INTERNAL_HOST=http://image_server:1024

# CORS and Hosts
ALLOWED_HOSTS=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# Email — error-notification recipients (ADMINS) and outgoing SMTP. Left
# blank/console-backend for local/CI; production sets real SMTP credentials
# and at least one ADMIN_EMAILS address to receive error-notification mail.
# (comma separated)
ADMIN_EMAILS=
SERVER_EMAIL=root@localhost
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Choices
HISTORICAL_ITEM_TYPES="Agreement,Charter,Letter"
HISTORICAL_ITEM_HAIR_TYPES="FHFH,FHHF,HFFH,HFHF,Mixed"
REPOSITORY_TYPES="Library,Institution,Person,Online Resource"
CHARACTER_ITEM_TYPES="Majuscule Letter,Minuscule Letter,Numeral,Punctuation,Symbol,Accent"

LOG_IN_FILE=False
